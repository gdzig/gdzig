{
  "$schema": "https://raw.githubusercontent.com/DonIsaac/zlint/refs/tags/v0.10.0/zlint.schema.json",
  "ignore": [
    "src/class/**",
    "src/builtin/**",
    "src/global/**",
    "!src/class/**/*.mixin.zig",
    "!src/class/**/*.replace.zig",
    "!src/builtin/**/*.mixin.zig",
    "!src/builtin/**/*.replace.zig",
    "!src/global/**/*.mixin.zig",
    "!src/global/**/*.replace.zig",
    "src/gdzig.zig"
  ],
  "rules": {
    "gdzig-imports-sorted": [
      "error",
      {
        "skip_fragments": true,
        "std_modules": [
          "std",
          "builtin"
        ]
      }
    ],
    "gdzig-imports-placement": [
      "error",
      {
        "position": "bottom",
        "skip_fragments": true
      }
    ],
    "gdzig-file-name-case": "error",
    "gdzig-import-alias-case": "error",
    "gdzig-tests-last": [
      "error",
      {
        "skip_fragments": true
      }
    ],
    "gdzig-trailing-comma": "error",
    "gdzig-public-docs": "warn",
    "gdzig-inferred-initializers": "error",
    "gdzig-testing-usage": "error",
    "homeless-try": "error",
    "no-unresolved": "off",
    "unused-decls": "off",
    "unsafe-undefined": "off",
    "avoid-as": "off",
    "no-print": "off",
    "suppressed-errors": "off",
    "line-length": [
      "warn",
      {
        "max_length": 120
      }
    ],
    "empty-file": "off"
  }
}
